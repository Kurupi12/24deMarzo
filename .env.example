# ==============================================================================
# CORE ERP EMPRESARIAL - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# NEON POSTGRESQL SERVERLESS & PRISMA CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL: Cadena de conexión con Neon Connection Pooling (-pooler).
# Esencial para entornos Serverless en Vercel (Next.js App Router / Route Handlers)
# para evitar agotar conexiones simultáneas.
DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT_ID]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Conexión directa a Neon (sin el sufijo -pooler).
# Requerida obligatoriamente por Prisma para ejecutar migraciones (prisma migrate dev / deploy / db push).
DIRECT_URL="postgresql://neondb_owner:[PASSWORD]@[ENDPOINT_ID].[REGION].aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# ALMACENAMIENTO DE ARCHIVOS (VERCEL BLOB / CLOUDFLARE R2 / S3)
# ------------------------------------------------------------------------------
# Para legajos de personal, comprobantes y XMLs de SIFEN
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------------------------
# SEGURIDAD Y JWT PARA APIS EXTERNAS (E-COMMERCE & BIOMETRÍA CON IA)
# ------------------------------------------------------------------------------
ERP_API_KEY_BIOMETRICS="secret_biometrics_ingest_key_4m"
ERP_API_KEY_ECOMMERCE="secret_ecommerce_sync_key_4m"
NEXTAUTH_SECRET="long_and_cryptographically_secure_secret_key"
