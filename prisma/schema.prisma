// ==============================================================================
// CORE ERP EMPRESARIAL - PRISMA SCHEMA DEFINITION
// ==============================================================================
// Base de datos: PostgreSQL Serverless alojado en Neon (neon.tech)
// Conexión: Neon Connection Pooling en DATABASE_URL + Direct Connection en DIRECT_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// DOMINIO: AUTENTICACIÓN, ROLES Y ACCESOS
// ------------------------------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  GENERAL_MANAGER
  ACCOUNTANT
  CASHIER
  WAREHOUSE_MANAGER
  HR_MANAGER
  OPERATOR
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String
  passwordHash  String
  role          SystemRole  @default(OPERATOR)
  isActive      Boolean     @default(true)
  lastLoginAt   DateTime?
  
  // Relaciones operativas
  sales         Sale[]
  purchases     Purchase[]
  stockMoves    StockMovement[]
  verifiedAttendances AttendanceRecord[] @relation("AttendanceVerifier")
  approvedAdvances    AdvancePayment[]   @relation("AdvanceApprover")
  approvedLeaves      LeaveRequest[]     @relation("LeaveApprover")

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("users")
}

// ------------------------------------------------------------------------------
// DOMINIO: CATÁLOGO MAESTRO E INVENTARIO (COMPATIBLE SIFEN / DNIT)
// ------------------------------------------------------------------------------

enum VatRate {
  IVA_10    // Tasa general 10%
  IVA_5     // Tasa reducida 5% (canasta básica, salud, agro)
  EXEMPT    // Exento de IVA
}

enum SifenUnitOfMeasure {
  UNIDAD    // 77 - Unidades
  KILOGRAMO // 83 - Kilogramos
  GRAMO     // 84 - Gramos
  METRO     // 87 - Metros
  LITRO     // 88 - Litros
  CAJA      // 78 - Cajas
  PAQUETE   // 80 - Paquetes
}

enum MovementType {
  IN_PURCHASE           // Entrada por compra
  OUT_SALE              // Salida por venta facturada
  TRANSFER_IN           // Entrada por traslado entre depósitos
  TRANSFER_OUT          // Salida por traslado entre depósitos
  ADJUSTMENT_POSITIVE   // Ajuste positivo de inventario
  ADJUSTMENT_NEGATIVE   // Ajuste negativo (pérdida, merma, rotura)
  INITIAL_STOCK         // Carga de inventario inicial
}

model Product {
  id              String             @id @default(uuid())
  sku             String             @unique
  barcode         String?            @unique // EAN-13 / GTIN
  name            String
  description     String?
  unitOfMeasure   SifenUnitOfMeasure @default(UNIDAD)
  vatRate         VatRate            @default(IVA_10)

  // Precios y costos (Moneda Guaraníes o configurable con Decimal)
  costPrice       Decimal            @default(0) @db.Decimal(14, 2)
  salePrice       Decimal            @default(0) @db.Decimal(14, 2)

  // Umbrales de control de stock
  minStockAlert   Decimal            @default(0) @db.Decimal(12, 2)
  maxStockLimit   Decimal?           @db.Decimal(12, 2)
  isActive        Boolean            @default(true)

  // Relaciones
  stockItems      StockItem[]
  movements       StockMovement[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model Warehouse {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  address         String?
  isMain          Boolean         @default(false)
  isActive        Boolean         @default(true)

  // Relaciones
  stockItems      StockItem[]
  originMovements StockMovement[] @relation("WarehouseOrigin")
  destMovements   StockMovement[] @relation("WarehouseDestination")

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("warehouses")
}

model StockItem {
  id              String      @id @default(uuid())
  productId       String
  warehouseId     String
  currentStock    Decimal     @default(0) @db.Decimal(12, 2)
  reservedStock   Decimal     @default(0) @db.Decimal(12, 2)

  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  updatedAt       DateTime    @updatedAt

  @@unique([productId, warehouseId])
  @@map("stock_items")
}

model StockMovement {
  id              String       @id @default(uuid())
  movementType    MovementType
  productId       String
  warehouseId     String       // Depósito afectado principal
  originWarehouseId String?    // Depósito origen en caso de transferencia
  
  quantity        Decimal      @db.Decimal(12, 2)
  unitCost        Decimal      @db.Decimal(14, 2)
  totalCost       Decimal      @db.Decimal(14, 2)
  previousStock   Decimal      @db.Decimal(12, 2)
  newStock        Decimal      @db.Decimal(12, 2)

  // Trazabilidad de documento origen
  referenceType   String?      // INVOICE, SALE, ADJUSTMENT_NOTE, SIFEN_DTE
  referenceId     String?
  notes           String?
  
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse    @relation("WarehouseDestination", fields: [warehouseId], references: [id])
  originWarehouse Warehouse?   @relation("WarehouseOrigin", fields: [originWarehouseId], references: [id])

  createdAt       DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId])
  @@map("stock_movements")
}

// ------------------------------------------------------------------------------
// DOMINIO: FACTURACIÓN, VENTAS Y COMPROBANTES FISCALES (SIFEN)
// ------------------------------------------------------------------------------

enum PaymentCondition {
  CONTADO
  CREDITO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA_BANCARIA
  CHEQUE
  BILLETERA_ELECTRONICA
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SifenDocType {
  FACTURA_ELECTRONICA
  AUTOFACTURA_ELECTRONICA
  NOTA_CREDITO_ELECTRONICA
  NOTA_DEBITO_ELECTRONICA
}

enum SifenStatus {
  DRAFT
  QUEUED
  APPROVED
  REJECTED
  CANCELLED
}

enum CashMovementType {
  INCOME_CHANGE        // Ingreso de sencillo / cambio para dar vuelto
  EXPENSE_OPERATION    // Egreso / Gasto operativo (compra de agua, limpieza, etc.)
  EXPENSE_ADVANCE      // Adelanto de sueldo a personal (ej: Carlos Cabañas)
  SAFE_DEPOSIT         // Retiro de excedente de billetes grandes (100k / 50k) a sobre / caja fuerte
}

model CashRegister {
  id          String      @id @default(uuid())
  code        String      @unique // Ej: CAJA-01
  name        String
  isActive    Boolean     @default(true)
  shifts      CashShift[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("cash_registers")
}

model CashShift {
  id                     String         @id @default(uuid())
  cashRegisterId         String
  openedByUserId         String
  closedByUserId         String?
  openedAt               DateTime       @default(now())
  closedAt               DateTime?

  // Arqueo y Comprobación Inicial a Ciegas ("Blind Count")
  openingBalance         Decimal        @db.Decimal(14, 2) // Lo que el cajero cuenta físicamente
  expectedOpeningBalance Decimal?       @db.Decimal(14, 2) // Saldo que dejó el cierre anterior
  openingDifference      Decimal?       @db.Decimal(14, 2) // openingBalance - expectedOpeningBalance
  openingNotes           String?        // Observación justificada si hubo diferencia al abrir

  // Cierre de Turno Inmutable
  closingBalance         Decimal?       @db.Decimal(14, 2) // Efectivo físico en cajón al cierre
  expectedBalance        Decimal?       @db.Decimal(14, 2) // Efectivo calculado por sistema
  difference             Decimal?       @db.Decimal(14, 2) // closingBalance - expectedBalance
  closingNotes           String?

  // Totales Resumidos del Turno
  totalCashSales         Decimal        @default(0) @db.Decimal(14, 2)
  totalIncomes           Decimal        @default(0) @db.Decimal(14, 2) // Total ingresos de sencillo
  totalExpenses          Decimal        @default(0) @db.Decimal(14, 2) // Total gastos/adelantos
  totalSafeDeposits      Decimal        @default(0) @db.Decimal(14, 2) // Total retirado a sobres

  isOpen                 Boolean        @default(true)

  cashRegister           CashRegister   @relation(fields: [cashRegisterId], references: [id])
  sales                  Sale[]
  movements              CashMovement[]

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @default(now()) @updatedAt

  @@index([cashRegisterId, openedAt])
  @@map("cash_shifts")
}

model CashMovement {
  id           String           @id @default(uuid())
  cashShiftId  String
  type         CashMovementType
  category     String           // "SENCILLO", "ADELANTO_PERSONAL", "BIDONES_AGUA", "FLETE_MENOR", "EXTRACCION_SOBRE", "OTROS"
  amount       Decimal          @db.Decimal(14, 2)
  description  String           // Motivo / justificación obligatoria
  beneficiary  String?          // Persona que recibió o entregó (ej: "Carlos Cabañas")
  envelopeCode String?          // N° o código de sobre si es extracción de billetes
  receiptNo    String?          // N° recibo físico de respaldo

  shift        CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@index([cashShiftId])
  @@map("cash_movements")
}

model Sale {
  id               String           @id @default(uuid())
  saleNumber       String           @unique
  cashShiftId      String?
  userId           String
  
  // Datos del Cliente (preparados para Facturación Electrónica DNIT)
  customerName     String
  customerRuc      String           // RUC o CI con DV ej: 80012345-6
  customerEmail    String?
  customerAddress  String?

  paymentCondition PaymentCondition @default(CONTADO)
  paymentMethod    PaymentMethod    @default(EFECTIVO)
  creditTermDays   Int?             @default(0)

  // Totales y Desglose Tributario SIFEN
  subtotal         Decimal          @db.Decimal(14, 2)
  discountTotal    Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal          @db.Decimal(14, 2)
  
  totalExempt      Decimal          @default(0) @db.Decimal(14, 2)
  totalVat5        Decimal          @default(0) @db.Decimal(14, 2)
  totalVat10       Decimal          @default(0) @db.Decimal(14, 2)
  vat5Amount       Decimal          @default(0) @db.Decimal(14, 2) // Liquidación IVA 5% (Base / 21)
  vat10Amount      Decimal          @default(0) @db.Decimal(14, 2) // Liquidación IVA 10% (Base / 11)

  status           SaleStatus       @default(COMPLETED)

  // Despacho y Logística de Entrega (Trazabilidad de Chofer y Ayudantes - 1er Envío)
  projectId        String?
  project          CustomerProject? @relation(fields: [projectId], references: [id])
  driverId         String?
  driver           Employee?        @relation("SaleDriver", fields: [driverId], references: [id])
  helperIds        String[]         @default([])
  vehiclePlate     String?
  deliveryStatus   String           @default("DELIVERED")
  deliveryNotes    String?

  // 2do Chofer y 2do Camión (para envíos dobles o de gran volumen)
  secondaryDriverId String?
  secondaryDriver   Employee?       @relation("SaleSecondaryDriver", fields: [secondaryDriverId], references: [id])
  secondaryHelperIds String[]       @default([])
  secondaryVehiclePlate String?

  // Relaciones
  user             User             @relation(fields: [userId], references: [id])
  cashShift        CashShift?       @relation(fields: [cashShiftId], references: [id])
  items            SaleItem[]
  invoice          Invoice?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([customerRuc])
  @@index([projectId])
  @@index([driverId])
  @@index([createdAt])
  @@map("sales")
}

model CustomerProject {
  id           String   @id @default(uuid())
  customerRuc  String   // RUC o CI del cliente al que pertenece la obra
  name         String   // Ej: "Edificio Altamira - Piso 4", "Obra Villa Morra"
  address      String   // Dirección de descarga / entrega
  contactName  String?  // Capataz / Encargado de obra / Arquitecto
  contactPhone String?  // Teléfono del contacto en obra
  isActive     Boolean  @default(true)
  
  sales        Sale[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerRuc])
  @@map("customer_projects")
}

model Customer {
  id           String   @id @default(uuid())
  ruc          String   @unique // RUC o CI con DV ej: 80012345-6
  name         String   // Razón Social o Nombre Completo
  email        String?
  address      String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([ruc])
  @@map("customers")
}

model SaleItem {
  id              String      @id @default(uuid())
  saleId          String
  productId       String
  quantity        Decimal     @db.Decimal(12, 2)
  unitPrice       Decimal     @db.Decimal(14, 2)
  discount        Decimal     @default(0) @db.Decimal(14, 2)
  vatRate         VatRate     @default(IVA_10)
  subtotal        Decimal     @db.Decimal(14, 2)
  vatAmount       Decimal     @db.Decimal(14, 2)

  sale            Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Invoice {
  id              String        @id @default(uuid())
  saleId          String        @unique
  invoiceNumber   String        @unique // Formato: 001-001-0000123
  dteType         SifenDocType  @default(FACTURA_ELECTRONICA)
  
  // Parámetros Fiscales SIFEN (DNIT Paraguay)
  cdc             String?       @unique // Código Digital de Control (44 dígitos alfanuméricos)
  sifenStatus     SifenStatus   @default(DRAFT)
  protocolNumber  String?
  qrCodeUrl       String?
  xmlFileUrl      String?       // Ubicación en Supabase Storage
  responsePayload Json?         // Respuesta cruda recibida de la API SIFEN

  issueDate       DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([cdc])
  @@index([sifenStatus])
  @@map("invoices")
}

// ------------------------------------------------------------------------------
// DOMINIO: RECURSOS HUMANOS, NÓMINA Y BIOMETRÍA CON IA
// ------------------------------------------------------------------------------

enum DocumentType {
  CI_PARAGUAY
  PASSPORT
  FOREIGN_DNI
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum AdvanceStatus {
  REQUESTED
  APPROVED
  REJECTED
  DEDUCTED_IN_PAYROLL
  CANCELLED
}

enum LeaveType {
  ANNUAL_VACATION
  MEDICAL_LEAVE
  MATERNITY_LEAVE
  PATERNITY_LEAVE
  BEREAVEMENT
  UNPAID_PERMISSION
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceSource {
  AI_CAMERA_VISION    // Webhook / API desde cámaras inteligentes
  BIOMETRIC_DEVICE    // Reloj marcador biométrico tradicional
  WEB_MANUAL_ENTRY    // Carga administrativa autorizada
  MOBILE_GEO_CHECKIN  // Marcación móvil geolocalizada
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  BREAK_OUT
  BREAK_IN
}

model Employee {
  id              String             @id @default(uuid())
  code            String             @unique // Legajo de Empleado (ej: EMP-001)
  documentType    DocumentType       @default(CI_PARAGUAY)
  documentNumber  String             @unique // Cédula de Identidad
  firstName       String
  lastName        String
  birthDate       DateTime
  gender          String?
  email           String?
  phone           String?
  address         String?

  jobTitle        String
  department      String
  hireDate        DateTime
  terminationDate DateTime?
  status          EmployeeStatus     @default(ACTIVE)

  // Integración Biométrica / Cámaras IA
  biometricId     String?            @unique // ID en sistema de reconocimiento facial
  faceEmbeddingId String?            // Identificador vectorial o referencia externa
  documentsFolder String?            // Carpeta en Supabase Storage para legajo

  // Relaciones
  salaryStructure SalaryStructure?
  advancePayments AdvancePayment[]
  leaveRequests   LeaveRequest[]
  attendances     AttendanceRecord[]
  drivenSales     Sale[]             @relation("SaleDriver")
  secondaryDrivenSales Sale[]        @relation("SaleSecondaryDriver")

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([documentNumber])
  @@index([biometricId])
  @@map("employees")
}

enum SalaryFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model SalaryStructure {
  id                   String          @id @default(uuid())
  employeeId           String          @unique
  baseSalary           Decimal         @db.Decimal(14, 2)
  paymentFrequency     SalaryFrequency @default(WEEKLY)
  weeklySalary         Decimal?        @db.Decimal(14, 2)
  currency             String          @default("PYG")
  
  // Porcentajes legales y complementos (ej: IPS Obrero 9% en Paraguay)
  ipsDeductionPercent  Decimal         @default(9.00) @db.Decimal(5, 2)
  familyAllowance      Decimal         @default(0) @db.Decimal(14, 2) // Asignación familiar
  fixedBonus           Decimal         @default(0) @db.Decimal(14, 2) // Bonificación fija
  isActive             Boolean         @default(true)
  effectiveDate        DateTime        @default(now())

  employee             Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedAt            DateTime        @updatedAt

  @@map("salary_structures")
}

model AdvancePayment {
  id              String        @id @default(uuid())
  employeeId      String
  amount          Decimal       @db.Decimal(14, 2)
  requestDate     DateTime      @default(now())
  deductionPeriod String        // Periodo fiscal a descontar: "YYYY-MM" (ej: "2026-11")
  status          AdvanceStatus @default(REQUESTED)
  reason          String?
  
  approvedById    String?
  approvedBy      User?         @relation("AdvanceApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  notes           String?

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId, deductionPeriod])
  @@map("advance_payments")
}

model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String
  leaveType       LeaveType
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  status          LeaveStatus @default(PENDING)
  reason          String?
  documentFileUrl String?     // Certificado médico o reposo en Supabase Storage

  approvedById    String?
  approvedBy      User?       @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId])
  @@map("leave_requests")
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  employeeId      String
  recordedAt      DateTime
  type            AttendanceType   @default(CHECK_IN)
  source          AttendanceSource @default(AI_CAMERA_VISION)
  
  // Parámetros de confianza para Visión Artificial y Biometría
  confidenceScore Decimal?         @db.Decimal(5, 4) // Ej: 0.9854
  deviceId        String?          // Cámara o equipo que emitió la captura
  snapshotUrl     String?          // Foto capturada por la IA alojada en Supabase Storage
  
  isVerified      Boolean          @default(true)
  verifiedById    String?
  verifiedBy      User?            @relation("AttendanceVerifier", fields: [verifiedById], references: [id])
  rawPayload      Json?            // Datos completos del webhook de visión

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())

  @@index([employeeId, recordedAt])
  @@index([recordedAt])
  @@map("attendance_records")
}

// ------------------------------------------------------------------------------
// DOMINIO: REGISTRO DE PROVEEDORES & COMPRAS A ENTRADAS DE KARDEX
// ------------------------------------------------------------------------------

model Supplier {
  id           String   @id @default(uuid())
  ruc          String   @unique // RUC o CI del proveedor con DV (ej: 80000001-3)
  name         String   // Razón Social oficial
  tradeName    String?  // Nombre de fantasía / Marca (ej: INC, Yguazú, Aceros Vemarcorp)
  category     String   @default("GENERAL") // CEMENTERA, HIERROS, CERAMICAS, ARIDOS, HERRAMIENTAS, GENERAL
  contactName  String?  // Nombre del asesor / vendedor / encargado comercial
  phone        String?  // Teléfono o WhatsApp de pedidos
  email        String?  // Correo de facturación / pedidos
  address      String?  // Dirección de planta o sucursal
  city         String?  // Ciudad (ej: Asunción, Villeta, Villa Hayes)
  creditDays   Int      @default(0) // Días habituales de crédito (0 = Contado)
  notes        String?  // Observaciones, lista de descuentos o condiciones
  isActive     Boolean  @default(true)

  purchases    Purchase[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([ruc])
  @@index([category])
  @@map("suppliers")
}

model Purchase {
  id               String           @id @default(uuid())
  purchaseNumber   String           @unique // Formato: COM-0001
  invoiceNumber    String           // Factura física del proveedor (ej: 001-002-0045612)
  supplierId       String?
  supplier         Supplier?        @relation(fields: [supplierId], references: [id])
  supplierRuc      String           // RUC o CI del proveedor con DV
  supplierName     String           // Razón Social / Nombre del proveedor
  purchaseDate     DateTime         @default(now())
  paymentCondition PaymentCondition @default(CONTADO)
  subtotal         Decimal          @db.Decimal(14, 2)
  vatAmount        Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal          @db.Decimal(14, 2)
  notes            String?
  status           String           @default("COMPLETED")

  userId           String
  user             User             @relation(fields: [userId], references: [id])

  items            PurchaseItem[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([supplierRuc])
  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal  @db.Decimal(14, 2)
  subtotal   Decimal  @db.Decimal(14, 2)
  vatRate    VatRate  @default(IVA_10)

  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ------------------------------------------------------------------------------
// DOMINIO: LOGÍSTICA & FLOTA DE VEHÍCULOS
// ------------------------------------------------------------------------------

model Vehicle {
  id           String   @id @default(uuid())
  code         String?  @unique // Ej: CAM-01, FUR-02
  plateNumber  String   @unique // Chapa (ej: ABC-123)
  brand        String   // Ej: Scania, Mercedes-Benz, Kia, Isuzu
  model        String   // Ej: 113H, 1114, K2700
  capacityTons Decimal? @db.Decimal(8, 2)
  notes        String?
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vehicles")
}

