// ==============================================================================
// CORE ERP EMPRESARIAL - PRISMA SCHEMA DEFINITION
// ==============================================================================
// Base de datos: PostgreSQL Serverless alojado en Neon (neon.tech)
// Conexión: Neon Connection Pooling en DATABASE_URL + Direct Connection en DIRECT_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// DOMINIO: AUTENTICACIÓN, ROLES Y ACCESOS
// ------------------------------------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  GENERAL_MANAGER
  ACCOUNTANT
  CASHIER
  WAREHOUSE_MANAGER
  HR_MANAGER
  OPERATOR
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  name          String
  passwordHash  String
  role          SystemRole  @default(OPERATOR)
  isActive      Boolean     @default(true)
  lastLoginAt   DateTime?
  
  // Relaciones operativas
  sales         Sale[]
  stockMoves    StockMovement[]
  verifiedAttendances AttendanceRecord[] @relation("AttendanceVerifier")
  approvedAdvances    AdvancePayment[]   @relation("AdvanceApprover")
  approvedLeaves      LeaveRequest[]     @relation("LeaveApprover")

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("users")
}

// ------------------------------------------------------------------------------
// DOMINIO: CATÁLOGO MAESTRO E INVENTARIO (COMPATIBLE SIFEN / DNIT)
// ------------------------------------------------------------------------------

enum VatRate {
  IVA_10    // Tasa general 10%
  IVA_5     // Tasa reducida 5% (canasta básica, salud, agro)
  EXEMPT    // Exento de IVA
}

enum SifenUnitOfMeasure {
  UNIDAD    // 77 - Unidades
  KILOGRAMO // 83 - Kilogramos
  GRAMO     // 84 - Gramos
  METRO     // 87 - Metros
  LITRO     // 88 - Litros
  CAJA      // 78 - Cajas
  PAQUETE   // 80 - Paquetes
}

enum MovementType {
  IN_PURCHASE           // Entrada por compra
  OUT_SALE              // Salida por venta facturada
  TRANSFER_IN           // Entrada por traslado entre depósitos
  TRANSFER_OUT          // Salida por traslado entre depósitos
  ADJUSTMENT_POSITIVE   // Ajuste positivo de inventario
  ADJUSTMENT_NEGATIVE   // Ajuste negativo (pérdida, merma, rotura)
  INITIAL_STOCK         // Carga de inventario inicial
}

model Product {
  id              String             @id @default(uuid())
  sku             String             @unique
  barcode         String?            @unique // EAN-13 / GTIN
  name            String
  description     String?
  unitOfMeasure   SifenUnitOfMeasure @default(UNIDAD)
  vatRate         VatRate            @default(IVA_10)

  // Precios y costos (Moneda Guaraníes o configurable con Decimal)
  costPrice       Decimal            @default(0) @db.Decimal(14, 2)
  salePrice       Decimal            @default(0) @db.Decimal(14, 2)

  // Umbrales de control de stock
  minStockAlert   Decimal            @default(0) @db.Decimal(12, 2)
  maxStockLimit   Decimal?           @db.Decimal(12, 2)
  isActive        Boolean            @default(true)

  // Relaciones
  stockItems      StockItem[]
  movements       StockMovement[]
  saleItems       SaleItem[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([barcode])
  @@index([sku])
  @@map("products")
}

model Warehouse {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  address         String?
  isMain          Boolean         @default(false)
  isActive        Boolean         @default(true)

  // Relaciones
  stockItems      StockItem[]
  originMovements StockMovement[] @relation("WarehouseOrigin")
  destMovements   StockMovement[] @relation("WarehouseDestination")

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("warehouses")
}

model StockItem {
  id              String      @id @default(uuid())
  productId       String
  warehouseId     String
  currentStock    Decimal     @default(0) @db.Decimal(12, 2)
  reservedStock   Decimal     @default(0) @db.Decimal(12, 2)

  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  updatedAt       DateTime    @updatedAt

  @@unique([productId, warehouseId])
  @@map("stock_items")
}

model StockMovement {
  id              String       @id @default(uuid())
  movementType    MovementType
  productId       String
  warehouseId     String       // Depósito afectado principal
  originWarehouseId String?    // Depósito origen en caso de transferencia
  
  quantity        Decimal      @db.Decimal(12, 2)
  unitCost        Decimal      @db.Decimal(14, 2)
  totalCost       Decimal      @db.Decimal(14, 2)
  previousStock   Decimal      @db.Decimal(12, 2)
  newStock        Decimal      @db.Decimal(12, 2)

  // Trazabilidad de documento origen
  referenceType   String?      // INVOICE, SALE, ADJUSTMENT_NOTE, SIFEN_DTE
  referenceId     String?
  notes           String?
  
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse    @relation("WarehouseDestination", fields: [warehouseId], references: [id])
  originWarehouse Warehouse?   @relation("WarehouseOrigin", fields: [originWarehouseId], references: [id])

  createdAt       DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId])
  @@map("stock_movements")
}

// ------------------------------------------------------------------------------
// DOMINIO: FACTURACIÓN, VENTAS Y COMPROBANTES FISCALES (SIFEN)
// ------------------------------------------------------------------------------

enum PaymentCondition {
  CONTADO
  CREDITO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA_DEBITO
  TARJETA_CREDITO
  TRANSFERENCIA_BANCARIA
  CHEQUE
  BILLETERA_ELECTRONICA
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SifenDocType {
  FACTURA_ELECTRONICA
  AUTOFACTURA_ELECTRONICA
  NOTA_CREDITO_ELECTRONICA
  NOTA_DEBITO_ELECTRONICA
}

enum SifenStatus {
  DRAFT
  QUEUED
  APPROVED
  REJECTED
  CANCELLED
}

model CashRegister {
  id          String      @id @default(uuid())
  code        String      @unique // Ej: CAJA-01
  name        String
  isActive    Boolean     @default(true)
  shifts      CashShift[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("cash_registers")
}

model CashShift {
  id              String       @id @default(uuid())
  cashRegisterId  String
  openedByUserId  String
  closedByUserId  String?
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  openingBalance  Decimal      @db.Decimal(14, 2)
  closingBalance  Decimal?     @db.Decimal(14, 2)
  expectedBalance Decimal?     @db.Decimal(14, 2)
  difference      Decimal?     @db.Decimal(14, 2)
  isOpen          Boolean      @default(true)

  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id])
  sales           Sale[]

  @@map("cash_shifts")
}

model Sale {
  id               String           @id @default(uuid())
  saleNumber       String           @unique
  cashShiftId      String?
  userId           String
  
  // Datos del Cliente (preparados para Facturación Electrónica DNIT)
  customerName     String
  customerRuc      String           // RUC o CI con DV ej: 80012345-6
  customerEmail    String?
  customerAddress  String?

  paymentCondition PaymentCondition @default(CONTADO)
  paymentMethod    PaymentMethod    @default(EFECTIVO)
  creditTermDays   Int?             @default(0)

  // Totales y Desglose Tributario SIFEN
  subtotal         Decimal          @db.Decimal(14, 2)
  discountTotal    Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal          @db.Decimal(14, 2)
  
  totalExempt      Decimal          @default(0) @db.Decimal(14, 2)
  totalVat5        Decimal          @default(0) @db.Decimal(14, 2)
  totalVat10       Decimal          @default(0) @db.Decimal(14, 2)
  vat5Amount       Decimal          @default(0) @db.Decimal(14, 2) // Liquidación IVA 5% (Base / 21)
  vat10Amount      Decimal          @default(0) @db.Decimal(14, 2) // Liquidación IVA 10% (Base / 11)

  status           SaleStatus       @default(COMPLETED)

  // Relaciones
  user             User             @relation(fields: [userId], references: [id])
  cashShift        CashShift?       @relation(fields: [cashShiftId], references: [id])
  items            SaleItem[]
  invoice          Invoice?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([customerRuc])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id              String      @id @default(uuid())
  saleId          String
  productId       String
  quantity        Decimal     @db.Decimal(12, 2)
  unitPrice       Decimal     @db.Decimal(14, 2)
  discount        Decimal     @default(0) @db.Decimal(14, 2)
  vatRate         VatRate     @default(IVA_10)
  subtotal        Decimal     @db.Decimal(14, 2)
  vatAmount       Decimal     @db.Decimal(14, 2)

  sale            Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Invoice {
  id              String        @id @default(uuid())
  saleId          String        @unique
  invoiceNumber   String        @unique // Formato: 001-001-0000123
  dteType         SifenDocType  @default(FACTURA_ELECTRONICA)
  
  // Parámetros Fiscales SIFEN (DNIT Paraguay)
  cdc             String?       @unique // Código Digital de Control (44 dígitos alfanuméricos)
  sifenStatus     SifenStatus   @default(DRAFT)
  protocolNumber  String?
  qrCodeUrl       String?
  xmlFileUrl      String?       // Ubicación en Supabase Storage
  responsePayload Json?         // Respuesta cruda recibida de la API SIFEN

  issueDate       DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([cdc])
  @@index([sifenStatus])
  @@map("invoices")
}

// ------------------------------------------------------------------------------
// DOMINIO: RECURSOS HUMANOS, NÓMINA Y BIOMETRÍA CON IA
// ------------------------------------------------------------------------------

enum DocumentType {
  CI_PARAGUAY
  PASSPORT
  FOREIGN_DNI
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum AdvanceStatus {
  REQUESTED
  APPROVED
  REJECTED
  DEDUCTED_IN_PAYROLL
  CANCELLED
}

enum LeaveType {
  ANNUAL_VACATION
  MEDICAL_LEAVE
  MATERNITY_LEAVE
  PATERNITY_LEAVE
  BEREAVEMENT
  UNPAID_PERMISSION
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceSource {
  AI_CAMERA_VISION    // Webhook / API desde cámaras inteligentes
  BIOMETRIC_DEVICE    // Reloj marcador biométrico tradicional
  WEB_MANUAL_ENTRY    // Carga administrativa autorizada
  MOBILE_GEO_CHECKIN  // Marcación móvil geolocalizada
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  BREAK_OUT
  BREAK_IN
}

model Employee {
  id              String             @id @default(uuid())
  code            String             @unique // Legajo de Empleado (ej: EMP-001)
  documentType    DocumentType       @default(CI_PARAGUAY)
  documentNumber  String             @unique // Cédula de Identidad
  firstName       String
  lastName        String
  birthDate       DateTime
  gender          String?
  email           String?
  phone           String?
  address         String?

  jobTitle        String
  department      String
  hireDate        DateTime
  terminationDate DateTime?
  status          EmployeeStatus     @default(ACTIVE)

  // Integración Biométrica / Cámaras IA
  biometricId     String?            @unique // ID en sistema de reconocimiento facial
  faceEmbeddingId String?            // Identificador vectorial o referencia externa
  documentsFolder String?            // Carpeta en Supabase Storage para legajo

  // Relaciones
  salaryStructure SalaryStructure?
  advancePayments AdvancePayment[]
  leaveRequests   LeaveRequest[]
  attendances     AttendanceRecord[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([documentNumber])
  @@index([biometricId])
  @@map("employees")
}

enum SalaryFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model SalaryStructure {
  id                   String          @id @default(uuid())
  employeeId           String          @unique
  baseSalary           Decimal         @db.Decimal(14, 2)
  paymentFrequency     SalaryFrequency @default(WEEKLY)
  weeklySalary         Decimal?        @db.Decimal(14, 2)
  currency             String          @default("PYG")
  
  // Porcentajes legales y complementos (ej: IPS Obrero 9% en Paraguay)
  ipsDeductionPercent  Decimal         @default(9.00) @db.Decimal(5, 2)
  familyAllowance      Decimal         @default(0) @db.Decimal(14, 2) // Asignación familiar
  fixedBonus           Decimal         @default(0) @db.Decimal(14, 2) // Bonificación fija
  isActive             Boolean         @default(true)
  effectiveDate        DateTime        @default(now())

  employee             Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedAt            DateTime        @updatedAt

  @@map("salary_structures")
}

model AdvancePayment {
  id              String        @id @default(uuid())
  employeeId      String
  amount          Decimal       @db.Decimal(14, 2)
  requestDate     DateTime      @default(now())
  deductionPeriod String        // Periodo fiscal a descontar: "YYYY-MM" (ej: "2026-11")
  status          AdvanceStatus @default(REQUESTED)
  reason          String?
  
  approvedById    String?
  approvedBy      User?         @relation("AdvanceApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  notes           String?

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId, deductionPeriod])
  @@map("advance_payments")
}

model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String
  leaveType       LeaveType
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  status          LeaveStatus @default(PENDING)
  reason          String?
  documentFileUrl String?     // Certificado médico o reposo en Supabase Storage

  approvedById    String?
  approvedBy      User?       @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId])
  @@map("leave_requests")
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  employeeId      String
  recordedAt      DateTime
  type            AttendanceType   @default(CHECK_IN)
  source          AttendanceSource @default(AI_CAMERA_VISION)
  
  // Parámetros de confianza para Visión Artificial y Biometría
  confidenceScore Decimal?         @db.Decimal(5, 4) // Ej: 0.9854
  deviceId        String?          // Cámara o equipo que emitió la captura
  snapshotUrl     String?          // Foto capturada por la IA alojada en Supabase Storage
  
  isVerified      Boolean          @default(true)
  verifiedById    String?
  verifiedBy      User?            @relation("AttendanceVerifier", fields: [verifiedById], references: [id])
  rawPayload      Json?            // Datos completos del webhook de visión

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())

  @@index([employeeId, recordedAt])
  @@index([recordedAt])
  @@map("attendance_records")
}

